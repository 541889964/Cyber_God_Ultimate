<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp">

    <TextView android:id="@+id/tvSysInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="System Ready" android:textColor="#00FFCC" android:textSize="10sp" android:gravity="center" android:layout_marginBottom="4dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <EditText android:id="@+id/etKey" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
            android:hint="API Key" android:textColor="#FFF" android:textColorHint="#6B7280" android:background="#1F2937" android:padding="6dp" android:textSize="11sp"/>
        <Button android:id="@+id/btnSaveKey" android:layout_width="wrap_content" android:layout_height="36dp" android:text="加密保存" android:textSize="11sp" android:backgroundTint="#00FFCC" android:textColor="#000" android:insetTop="0dp" android:insetBottom="0dp"/>
        <Button android:id="@+id/btnSettings" android:layout_width="wrap_content" android:layout_height="36dp" android:text="设置" android:textSize="11sp" android:backgroundTint="#374151" android:textColor="#FFF" android:insetTop="0dp" android:insetBottom="0dp" android:layout_marginLeft="4dp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp" android:gravity="center_vertical">
        <Spinner android:id="@+id/spinnerModel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:background="#1F2937"/>
        <Spinner android:id="@+id/spinnerMode" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:background="#1F2937" android:layout_marginLeft="4dp"/>
        <Spinner android:id="@+id/spinnerEngine" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="36dp" android:background="#374151" android:layout_marginLeft="4dp"/>
    </LinearLayout>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:scrollbars="none">
        <LinearLayout android:id="@+id/layoutChips" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvChat"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:gravity="center_vertical">
        <EditText android:id="@+id/etMsg" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
            android:hint="随时输入指令..." android:textColor="#FFF" android:textColorHint="#6B7280" android:background="#1F2937" android:padding="12dp"/>
        <Button android:id="@+id/btnSend" android:layout_width="wrap_content" android:layout_height="48dp" android:text="执行" android:backgroundTint="#00FFCC" android:textColor="#000" android:insetTop="0dp" android:insetBottom="0dp"/>
    </LinearLayout>
</LinearLayout>
